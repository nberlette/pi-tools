  "scripts": {
    "dev": "next",
    "lint": "next lint",
    "start": "next start",
    "build": "next build",
    "deploy": "next lint && next build",
    "commit:pages": "touch out/.nojekyll && git add out && git commit -m 'chore: deploy to gh-pages'",
    "update:pages": "npm run commit:pages && git subtree push --prefix out origin gh-pages",
    "deploy:pages": "rm -rf node_modules/.cache && npm run deploy && npm run update:pages"
  },
  "homepage": "https://pi.berlette.com/",
  "packageManager": "bun@1.3.1",
  "dependencies": {
    "next": "16",
    "nextra": "~4.6.0",
    "nextra-theme-docs": "~4.6.0",
    "prism-react-renderer": "~2.4.1",
    "prismjs": "~1.30.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "tailwindcss": "~4.1.16"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "^19.2.2",
    "babel-plugin-transform-define": "^2.1.4",
    "eslint-config-next": "16",
    "sass": "~1.93.2",
    "typescript": "^5.9.3"
  }
}
